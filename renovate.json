{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "config:best-practices",
    "default:pinDigestsDisabled"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": ["* 0 1 * *"]
  },
  "timezone": "Etc/UTC",
  "schedule": ["* 0 1 * *"],
  "enabledManagers": ["nix", "github-actions", "cargo", "custom.regex"],
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "prCreation": "immediate",
  "automerge": false,
  "platformAutomerge": true,
  "forkProcessing": "enabled",
  "nix": {
    "enabled": true
  },
  "customManagers": [
    {
      "description": "Rename the nixpkgs channel ref in flake.nix (e.g. nixos-26.05 -> nixos-26.11). The nix manager only refreshes flake.lock and can never change the ref, which is how this sat on EOL nixos-25.11.",
      "customType": "regex",
      "managerFilePatterns": ["/^flake\\.nix$/"],
      "matchStrings": [
        "#\\s*renovate:\\s+datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s+packageName=(?<packageName>\\S+)\\s+versioning=(?<versioning>\\S+)[\\s\\S]*?url\\s*=\\s*\"[^\"]+/(?<currentValue>[^\"]+)\""
      ]
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["github-actions", "nix", "custom.regex"],
      "matchUpdateTypes": ["major", "minor", "patch", "pin"],
      "automerge": true
    }
  ]
}
